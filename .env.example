# Optional: enables AI-assisted narrative. Core app works without an API key.
AI_ENHANCEMENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: set a stable secret key for local session signing.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
